<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="live.nesh.music.phone">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher3"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicPhone"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="standard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".MyBroadcastReceiver"
            android:exported="false">
<!--            <intent-filter>-->
<!--                <action android:name="com.nesh.demo.MY_BROADCAST" />-->
<!--            </intent-filter>-->
        </receiver>

<!--        we need to mention broadcast receiver's package name and that broadcast receiver's class name explicitly-->
<!--        adb shell am broadcast -n com.nesh.demo1/live.nesh.music.phone.MyBroadcastReceiver -a com.nesh.demo.MY_BROADCAST-->
<!--        at the same time we need to set android:exported="true" in this broadcast receiver in the manifest-->

    </application>

</manifest>
